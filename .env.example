# OpenAI-compatible model service (DeepSeek by default)
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Optional: Baidu search
BAIDU_API_KEY=your-baidu-api-key

# Optional: automatic interview knowledge-base updates
KNOWLEDGE_SYNC_ENABLED=true
KNOWLEDGE_SYNC_INTERVAL_SECONDS=21600
# Optional for a public repository; raises the GitHub API rate limit.
KNOWLEDGE_GITHUB_TOKEN=
